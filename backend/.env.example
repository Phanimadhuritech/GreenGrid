# GreenGrid Backend Environment Configuration Template
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/greengrid?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
CLIENT_URL=http://localhost:5173

# Optional SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=GreenGrid Utility <no-reply@greengrid.com>
